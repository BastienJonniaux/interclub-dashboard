# Server Configuration
PORT=3001
NODE_ENV=development

# Database Connection (Local Docker or Cloud Neon/Supabase)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/interclub?schema=public"

# Director Admin Secret Key (used to authorize saving/locking compositions)
DIRECTOR_KEY="director1234"

# Allowed CORS origins (comma-separated, or * for all)
CORS_ORIGIN="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

